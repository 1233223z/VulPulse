# Copy to .env and adjust. Never commit .env.

# --- Application ---
VULPULSE_ENV=dev
VULPULSE_LOG_LEVEL=INFO
VULPULSE_DATA_DIR=./data
VULPULSE_LOG_DIR=./data/logs
# Discover third-party source plugins installed as Python packages.
VULPULSE_PLUGINS_ENABLED=true

# --- Database ---
VULPULSE_DATABASE_URL=sqlite+aiosqlite:///./data/vulpulse.db

# --- Admin API ---
# Required for /api/v1/admin/* and the /admin web UI login.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
VULPULSE_API_KEY=
# Signs admin session cookies. Set a stable random value in production.
VULPULSE_SESSION_SECRET=
# Set true when serving over HTTPS.
VULPULSE_SESSION_HTTPS_ONLY=false
VULPULSE_SESSION_MAX_AGE_HOURS=8

# --- Public API ---
# Per-client-IP limit for /api. Set 0 to disable application-level limiting.
VULPULSE_API_RATE_LIMIT_PER_MINUTE=120
# Comma-separated CIDRs of reverse proxies allowed to set X-Forwarded-For.
# Leave empty unless VulPulse is directly behind a trusted proxy.
VULPULSE_TRUSTED_PROXIES=
# Leave unset to enable /docs in dev/test and disable it in prod.
# VULPULSE_DOCS_ENABLED=true

# --- Data sources ---
# NVD API key is optional but strongly recommended (50 req/30s instead of 5).
VULPULSE_NVD_API_KEY=
VULPULSE_NVD_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
VULPULSE_EXPLOITDB_CSV_URL=https://gitlab.com/exploit-database/exploitdb/-/raw/main/files_exploits.csv
VULPULSE_EPSS_SCORES_URL=https://epss.empiricalsecurity.com/epss_scores-current.csv.gz
VULPULSE_HTTP_MAX_RESPONSE_BYTES=67108864
VULPULSE_HTTP_MAX_REDIRECTS=3

# --- Scheduler ---
VULPULSE_SCHEDULER_RUN_ON_START=true
VULPULSE_NVD_INTERVAL_MINUTES=60
VULPULSE_KEV_INTERVAL_HOURS=6
VULPULSE_EXPLOITDB_INTERVAL_HOURS=24
VULPULSE_EPSS_INTERVAL_HOURS=24
VULPULSE_NVD_LOOKBACK_DAYS=2
VULPULSE_NOTIFY_INTERVAL_MINUTES=5
VULPULSE_SCORE_INTERVAL_HOURS=6

# --- Risk scoring ---
VULPULSE_RISK_RECENCY_DAYS=90
VULPULSE_RISK_WEIGHT_CVSS=0.40
VULPULSE_RISK_WEIGHT_EPSS=0.25
VULPULSE_RISK_WEIGHT_KEV=0.20
VULPULSE_RISK_WEIGHT_EXPLOIT=0.10
VULPULSE_RISK_WEIGHT_RECENCY=0.05

# --- Notifications ---
VULPULSE_NOTIFY_MAX_ATTEMPTS=3
VULPULSE_NOTIFY_INITIAL_LOOKBACK_DAYS=7
VULPULSE_PUBLIC_BASE_URL=http://localhost:8000

# --- Notifications (optional) ---
VULPULSE_WECOM_WEBHOOK_URL=
# Comma-separated allowlist for WeCom webhook hosts (HTTPS only).
VULPULSE_WECOM_ALLOWED_HOSTS=qyapi.weixin.qq.com
VULPULSE_SMTP_HOST=
VULPULSE_SMTP_PORT=587
VULPULSE_SMTP_USERNAME=
VULPULSE_SMTP_PASSWORD=
VULPULSE_SMTP_FROM=
VULPULSE_SMTP_USE_TLS=true
VULPULSE_SMTP_USE_SSL=false
